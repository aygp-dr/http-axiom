{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure    {:mvn/version "1.12.6"}
  org.clojure/spec.alpha {:mvn/version "0.5.238"}

  ;; HTTP server
  ring/ring-core        {:mvn/version "1.12.2"}
  ring/ring-jetty-adapter {:mvn/version "1.12.2"}

  ;; Routing
  metosin/reitit-ring   {:mvn/version "0.7.2"}

  ;; JSON
  cheshire/cheshire     {:mvn/version "5.13.0"}

  ;; Database
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
  org.xerial/sqlite-jdbc {:mvn/version "3.46.1.0"}

  ;; JWT (stubbed for later epochs)
  buddy/buddy-sign      {:mvn/version "3.6.1-359"}}

 :aliases
 {;; Run the app (Jetty on port 8080): clojure -M:run, make dev or bb serve.
  ;; This was :dev until the clojure standard took :dev for the REPL.
  :run  {:main-opts ["-m" "todo.main"]}

  ;; REPL: clj -M:dev  (dev/user.clj instruments all s/fdef'd fns)
  :dev  {:extra-paths ["dev" "test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; bb test  ->  clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; bb lint  ->  clojure -M:lint --lint src test dev
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main"]}

  ;; bb fmt / bb fmt:fix  ->  clojure -M:fmt check|fix src test dev
  :fmt  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
         :main-opts ["-m" "cljfmt.main"]}}}
